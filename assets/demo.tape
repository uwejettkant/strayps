# Charmbracelet VHS tape file to record assets/demo.mp4 or assets/demo.gif
# Usage: vhs assets/demo.tape

Output assets/demo.gif
Output assets/demo.mp4

Set FontSize 15
Set Width 1000
Set Height 520
Set Padding 24
Set Theme "Catppuccin Mocha"

Type "npx agent-leash --demo"
Enter
Sleep 9s
Ctrl+C
Sleep 1s
