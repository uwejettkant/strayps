{
  "name": "strayps",
  "version": "0.1.0",
  "description": "See every AI coding agent and MCP server on your machine, find the ones left behind, and end them one session at a time",
  "license": "MIT",
  "author": "Uwe Jettkant",
  "homepage": "https://github.com/uwejettkant/strayps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwejettkant/strayps.git"
  },
  "bugs": {
    "url": "https://github.com/uwejettkant/strayps/issues"
  },
  "keywords": [
    "ai-agent",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "process-monitor",
    "orphan-processes",
    "coding-agents",
    "developer-tools",
    "cli"
  ],
  "bin": {
    "strayps": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/ui/public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:css && tsup",
    "build:css": "tailwindcss -i src/ui/styles/dashboard.css -o src/ui/public/dashboard.css --minify",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts watch",
    "demo": "tsx src/cli.ts watch --demo",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "commander": "^12.1.0",
    "hono": "^4.13.19",
    "ps-list": "^8.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "tailwindcss": "4.3.5",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
