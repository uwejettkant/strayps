{
  "name": "agent-leash",
  "version": "0.1.0",
  "description": "The AI Agent & MCP Watchdog for local repositories — circuit breaker for file thrashing, .env guard, and zombie MCP killer",
  "license": "MIT",
  "author": "Uwe Jettkant",
  "keywords": [
    "ai-agent",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "watchdog",
    "circuit-breaker",
    "coding-agents",
    "developer-tools",
    "cli"
  ],
  "bin": {
    "agent-leash": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/ui/public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:css && tsup",
    "build:css": "tailwindcss -i src/ui/styles/dashboard.css -o src/ui/public/dashboard.css --minify",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts watch",
    "demo": "tsx src/cli.ts watch --demo",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "commander": "^12.1.0",
    "hono": "^4.13.18",
    "ps-list": "^8.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tailwindcss": "4.3.5",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
